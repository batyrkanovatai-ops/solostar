// Функция сохранения и загрузки трофеев
function getTrophies() {
    return parseInt(localStorage.getItem('solostar_trophies') || '0', 10);
}

function addTrophies(amount) {
    let current = getTrophies();
    current = Math.max(0, current + amount);
    localStorage.setItem('solostar_trophies', current);
    return current;
}
